import java.util.Arrays;
import java.util.List;
import java.util.stream.Collectors;

public class FindDuplicatesWithStreams {
    public static void main(String[] args) {
        int[] arr = {1, 2, 3, 4, 5, 2, 3, 4};

        List<Integer> duplicates = Arrays.stream(arr)
                .boxed() // Convert int to Integer
                .collect(Collectors.groupingBy(e -> e, Collectors.counting()))
                .entrySet()
                .stream()
                .filter(entry -> entry.getValue() > 1)
                .map(entry -> entry.getKey())
                .collect(Collectors.toList());

        System.out.println("Duplicate elements: " + duplicates);
    }
}
//BOX
import java.util.Arrays;
import java.util.HashSet;
import java.util.Set;
import java.util.stream.Collectors;

public class FindDuplicatesWithStreamsAlternative {
    public static void main(String[] args) {
        int[] arr = {1, 2, 3, 4, 5, 2, 3, 4};

        Set<Integer> uniqueElements = new HashSet<>();
        
        Set<Integer> duplicates = Arrays.stream(arr)
                .filter(e -> !uniqueElements.add(e))
                .boxed()
                .collect(Collectors.toSet());

        System.out.println("Duplicate elements: " + duplicates);
    }
}
